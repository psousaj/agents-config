#!/usr/bin/env bash
set -euo pipefail

cd "$HOME/.agents" || exit 1

git add -A

if ! git diff --cached --quiet; then
  git commit -m "auto sync agents $(date '+%Y-%m-%d %H:%M')"
fi

if ! git pull --rebase; then
  git rebase --abort >/dev/null 2>&1 || true
  echo "Conflito ao fazer pull --rebase; push abortado." >&2
  exit 1
fi

git push
